# VITE_SERVER_URL=http://localhost:5001
# ↑ LOCAL DEV ONLY. Leave unset in production — the app calls /api/* on the
#   same origin automatically. Only set this if the API server runs on a
#   different host than the frontend (e.g. local dev against a remote backend).

VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
# ↑ Replace with your Clerk publishable key in every environment (Dev/Preview/Prod).

VITE_ASSISTANT_TIMEOUT_MS=60000