## Server configuration
# Clerk
CLERK_SECRET_KEY=sk_live_or_test_key

# Supabase storage
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=service-role-token
SUPABASE_BUCKET=chat-image-uploads

# Upload limits
UPLOAD_MAX_FILE_SIZE_MB=10
UPLOAD_MAX_FILE_COUNT=5
UPLOAD_SIGNED_URL_TTL_SECONDS=3600
UPLOAD_RETENTION_HOURS=24
UPLOAD_CLEANUP_CRON=0 18 * * *
UPLOAD_CLEANUP_TZ=Europe/London
PORT=5001
HOST=0.0.0.0

